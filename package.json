{
  "name": "jarvis-ai",
  "version": "1.0.0",
  "description": "Your personal AI voice assistant with persistent memory",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:client": "cd client && npm install && npm run build",
    "setup": "npm install && cd client && npm install && npm run build && cd .. && pip install edge-tts --break-system-packages && echo '✅ Setup complete! Run: npm start'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.77.0",
    "@langchain/anthropic": "^0.3.34",
    "@langchain/core": "^0.3.80",
    "@langchain/groq": "^0.2.4",
    "@langchain/textsplitters": "^0.1.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.10.0",
    "chrono-node": "^2.9.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "googleapis": "^171.4.0",
    "groq-sdk": "^0.8.0",
    "langchain": "^0.3.37",
    "node-cron": "^4.2.1",
    "speakeasy": "^2.0.0",
    "twilio": "^5.12.2",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  }
}
