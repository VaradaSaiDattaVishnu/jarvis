# Copy this file to `.env` and fill in values.
# `.env` is gitignored — real keys never get committed.

# --- Server ---
PORT=3001

# --- LLM provider (required) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Tools (optional) ---
# Enables the web `search` tool. Free key at https://tavily.com
TAVILY_API_KEY=

# --- Voice (optional) ---
# Enables speech-to-text (Whisper) at /transcribe. Free key at https://console.groq.com
# If unset, voice input is disabled but text chat still works.
GROQ_API_KEY=
