# ─── LLM brain (one of these is REQUIRED) ───────────────
# Groq is the free, fast default. Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: add a real Anthropic key to auto-upgrade the brain to Claude
# (claude-sonnet-4-6). When set and valid, it takes precedence over Groq.
# Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Server config
PORT=3000

# Persistent data directory (DB, encryption key, VAPID keypair, Google token,
# backups). In production point this at a mounted volume (e.g. /data on Railway)
# so data survives restarts. Defaults to the project root if unset.
# DATA_DIR=/data

# Jarvis config
JARVIS_NAME=Jarvis
JARVIS_VOICE=en-US-GuyNeural

# Memory settings
MAX_SHORT_TERM_MESSAGES=20

# Push Notifications (auto-generated on first run if not set)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:you@example.com

# Web Search — get free key at https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# Weather — get free key at https://openweathermap.org/api
# OPENWEATHER_API_KEY=
# USER_LOCATION=New York

# Encryption (auto-generated on first run if not set)
# JARVIS_ENCRYPTION_KEY=

# ─── Phase 3 ────────────────────────────────────

# Google Calendar — create OAuth2 credentials at https://console.cloud.google.com/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Twilio Phone Calls — get credentials at https://console.twilio.com/
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1234567890
# USER_PHONE_NUMBER=+1234567890
# PUBLIC_URL=https://your-domain.com

# ─── Phase 4: Proactive Engine ──────────────────
# Morning briefing (daily summary via push notification)
# ENABLE_BRIEFING=true
# BRIEFING_TIME=08:00
# BRIEFING_DELIVERY=push

# Smart nudges (check-in after inactivity)
# NUDGE_AFTER_HOURS=24
# NUDGE_QUIET_START=22
# NUDGE_QUIET_END=8

# ─── Phase 4: External Integrations ─────────────
# Spotify — create app at https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Home Assistant — get long-lived access token from HA settings
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=
